generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Only needed against a pooled connection (e.g. Supabase's pgBouncer pooler on
  // port 6543), which doesn't support the advisory locks `prisma migrate` needs.
  // Falls back to DATABASE_URL when DIRECT_URL isn't set, so this is a no-op for
  // a plain, unpooled Postgres instance (local dev, most other hosts).
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  BUYER
  VENDOR
  ADMIN
  // Separate from ADMIN: the only role that can see/manage the platform
  // wallet and the company/developer/super-admin revenue-split settings.
  // Regular ADMIN retains every other admin capability (vendor approval,
  // store settings, slides, vendor withdrawal approve/reject) but has no
  // visibility into those two — enforced both by RolesGuard on the API
  // (@Roles(UserRole.SUPER_ADMIN) only, vs. the shared ADMIN+SUPER_ADMIN
  // list everywhere else) and by hiding the mobile screens client-side.
  SUPER_ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum VendorOrderStatus {
  PENDING
  ACCEPTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  FLUTTERWAVE
  OPAY
  // Cash/card collected by the vendor at delivery instead of online — only
  // selectable at checkout when PlatformPaymentSettings.codEnabled is true.
  // Skips the gateway entirely: PaymentsService.initiate() marks the order
  // PAID immediately, same downstream state (VendorOrder ACCEPTED, wallet
  // credit on DELIVERED) as a real gateway webhook would.
  COD
}

enum PaymentStatus {
  INITIATED
  SUCCESSFUL
  FAILED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

enum IdentityVerificationType {
  NIN
  BVN
}

enum IdentityVerificationStatus {
  VERIFIED
  FAILED
  ERROR
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  phone              String?
  passwordHash       String
  // False only for a guest-checkout account (AuthService.guestCheckout) —
  // passwordHash there is a random, never-revealed value so the account
  // can't actually be logged into until AuthService.setPassword flips this
  // to true. Every other creation path (register, admin-created) sets a
  // real password up front, so this defaults true rather than needing a
  // backfill.
  hasPassword        Boolean   @default(true)
  firstName          String
  lastName           String
  role               UserRole  @default(BUYER)
  isActive           Boolean   @default(true)
  // Every user gets one, generated at creation regardless of how the
  // account was made — shareable so others can redeem it at registration.
  // Nullable only so the migration doesn't need to backfill every existing
  // row at once; genuinely new users always get one at creation time.
  referralCode       String?   @unique
  // Set only at self-registration when a valid referralCode was supplied —
  // see AuthService.register. Admin-created accounts never set this.
  referredById       String?
  // Real-time NIN/BVN lookup via Smile ID's synchronous ID-number API —
  // distinct from the async selfie-based Biometric KYC flow used for vendor
  // approval. Any user can verify; result isn't tied to vendor status.
  identityVerified   Boolean   @default(false)
  identityVerifiedAt DateTime?
  // Dojah liveness check (selfie-based anti-spoofing) — distinct from and
  // independent of identityVerified above. Currently only surfaced during
  // vendor onboarding, but modeled on User (not VendorProfile) since any
  // account type could reasonably need it later.
  livenessVerified   Boolean   @default(false)
  livenessVerifiedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  referredBy            User?                  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]                 @relation("Referrals")
  vendorProfile         VendorProfile?
  cart                  Cart?
  wallet                Wallet?
  addresses             Address[]
  orders                Order[]
  identityVerifications IdentityVerification[]
  sentVendorMessages    VendorMessage[]
  notifications         Notification[]

  @@map("users")
}

// Audit trail for real-time NIN/BVN lookups. Only a masked identifier and
// the name on record are kept — full ID numbers, DOB, phone, and address
// from the provider response are never persisted, only returned to the
// caller in the API response.
model IdentityVerification {
  id            String                     @id @default(uuid())
  userId        String
  idType        IdentityVerificationType
  idNumberLast4 String
  status        IdentityVerificationStatus
  resultCode    String?
  resultText    String?
  fullName      String?
  createdAt     DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_verifications")
}

model VendorProfile {
  id                         String       @id @default(uuid())
  userId                     String       @unique
  businessName               String
  description                String?
  logoUrl                    String?
  status                     VendorStatus @default(PENDING)
  commissionRate             Decimal      @default(10.0) @db.Decimal(5, 2)
  payoutAccount              Json?
  // Application-review documents (photo uploads, see uploads module) —
  // admin reviews these alongside the vendor's identity-verification status
  // (User.identityVerified, set via the real-time NIN/BVN check) before
  // approving. Replaces the old selfie-based async Biometric KYC flow.
  businessRegistrationDocUrl String?
  governmentIdDocUrl         String?
  // Set once VendorComplianceService's daily job has sent this vendor the
  // "verify soon or risk suspension" system message (>5 products listed,
  // still not identity+liveness verified, 2+ weeks since signup) — the
  // null-check in that job's query is what stops it re-sending the same
  // warning every day. Never reset back to null: once both checks pass,
  // the job's own `user: { OR: [identityVerified:false, ...] }` filter
  // permanently excludes the vendor regardless of this field, and there's
  // currently no way for a verified user to become unverified again.
  suspensionWarnedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  vendorOrders       VendorOrder[]
  wallet             Wallet?
  withdrawalRequests WithdrawalRequest[]
  messages           VendorMessage[]

  @@map("vendor_profiles")
}

// One thread per vendor, shared by every admin/super-admin — not
// per-admin-per-vendor — since a vendor only needs one line to "the
// platform team", not a separate inbox per admin who happens to reply.
// senderId (not a bare isFromAdmin flag) keeps a real audit trail of which
// admin said what, and lets the same schema carry the vendor's own replies
// (sender.role === VENDOR) without a separate column. A platform-wide
// broadcast (VendorsService.broadcast) is just this same row fanned out
// once per vendor, flagged isBroadcast so the vendor's UI can label it an
// announcement rather than a reply in an ongoing conversation. senderId is
// nullable + isSystemMessage for the one other source of rows here:
// VendorComplianceService's automated suspension-risk warning, which isn't
// authored by any particular human account.
model VendorMessage {
  id              String    @id @default(uuid())
  vendorId        String
  senderId        String?
  isSystemMessage Boolean   @default(false)
  body            String    @db.VarChar(4000)
  isBroadcast     Boolean   @default(false)
  // Two separate markers, not one: the vendor and "the admin team" (shared
  // across every admin) are different readers of the same thread. Set when
  // that side's messages endpoint is loaded — see VendorsService.listMessages.
  readByVendorAt DateTime?
  readByAdminAt  DateTime?
  createdAt      DateTime  @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@map("vendor_messages")
}

enum NotificationType {
  // Sent to the buyer the moment their order is confirmed (real payment
  // success or "pay on delivery" selected) — see PaymentsService.
  ORDER_CONFIRMED
  // Sent to every ADMIN/SUPER_ADMIN (userId null, see below) at the same
  // moment, so staff notice a paid order without polling the orders list.
  NEW_ORDER
}

// A lightweight, poll-based notification feed — same "no realtime infra"
// approach as VendorMessage's 5s polling, not a push-notification system
// (no device tokens are collected anywhere in this app yet).
model Notification {
  id        String            @id @default(uuid())
  // Null means "every admin" (see NotificationsService.notifyAdmins) rather
  // than one row per admin — mirrors VendorMessage's isBroadcast idea, just
  // as the addressing mechanism instead of a flag, since there's no single
  // "admin team" row to attach a userId to.
  userId    String?
  type      NotificationType
  title     String
  body      String            @db.VarChar(1000)
  orderId   String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("notifications")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  vendorId    String
  categoryId  String
  title       String
  description String
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("NGN")
  stock       Int           @default(0)
  images      String[]
  status      ProductStatus @default(DRAFT)
  // Free-text so a vendor can enter whatever unit makes sense for the
  // product (e.g. "5kg", "500g", "1 Litre", "Pack of 10") without a rigid
  // unit dropdown.
  weight      String?
  brand       String?
  sku         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String  @id @default(uuid())
  cartId     String
  productId  String
  quantity   Int
  priceAtAdd Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String   @default("Nigeria")
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Order {
  id               String           @id @default(uuid())
  buyerId          String
  addressId        String
  // Snapshot of AppSettings.deliveryFee at checkout time — totalAmount
  // already includes it (see OrdersService.checkout()), this field just
  // lets the receipt/order-detail UI show the subtotal/delivery split
  // even if the platform's fee changes later.
  deliveryFee      Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal          @db.Decimal(12, 2)
  currency         String           @default("NGN")
  status           OrderStatus      @default(PENDING_PAYMENT)
  paymentProvider  PaymentProvider?
  paymentReference String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  buyer         User           @relation(fields: [buyerId], references: [id])
  address       Address        @relation(fields: [addressId], references: [id])
  vendorOrders  VendorOrder[]
  payments      Payment[]
  notifications Notification[]

  @@index([buyerId])
  @@map("orders")
}

model VendorOrder {
  id                 String            @id @default(uuid())
  orderId            String
  vendorId           String
  subtotal           Decimal           @db.Decimal(12, 2)
  commissionAmount   Decimal           @db.Decimal(12, 2)
  vendorPayoutAmount Decimal           @db.Decimal(12, 2)
  // Subdivide commissionAmount (company + developer = commissionAmount) and a
  // flat extra cut of subtotal for the super-admin wallet — all frozen at
  // checkout time from PlatformPaymentSettings, same as the two fields above.
  companyAmount      Decimal           @default(0) @db.Decimal(12, 2)
  developerAmount    Decimal           @default(0) @db.Decimal(12, 2)
  superAdminAmount   Decimal           @default(0) @db.Decimal(12, 2)
  status             VendorOrderStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor             VendorProfile       @relation(fields: [vendorId], references: [id])
  items              OrderItem[]
  walletTransactions WalletTransaction[]

  @@index([orderId])
  @@index([vendorId])
  @@map("vendor_orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  vendorOrderId String
  productId     String
  title         String
  price         Decimal @db.Decimal(12, 2)
  quantity      Int

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  provider          PaymentProvider
  providerReference String          @unique
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("NGN")
  status            PaymentStatus   @default(INITIATED)
  rawWebhookPayload Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model AppSettings {
  id                  String   @id @default(uuid())
  primaryColor        String   @default("#111827")
  secondaryColor      String   @default("#4B5563")
  accentColor         String?
  logoUrl             String?
  // Flat NGN credit paid to a referrer's wallet when the person they
  // referred completes their first paid order — see WalletsService
  // .creditBuyerWallet and PaymentsService.markPaymentResult.
  referralBonusAmount Decimal  @default(500) @db.Decimal(12, 2)
  // Flat delivery charge added on top of the cart subtotal at checkout —
  // see OrdersService.checkout(). 0 by default (no delivery fee).
  deliveryFee         Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt           DateTime @updatedAt

  @@map("app_settings")
}

model Slide {
  id        String   @id @default(uuid())
  imageUrl  String
  title     String?
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("slides")
}

// Singleton (application-enforced, same convention as AppSettings): governs
// how each sale's commission is subdivided (company/developer, must sum to
// 100) and the flat extra cut of subtotal routed to the super-admin wallet.
// Only ever readable/writable by SUPER_ADMIN — see UserRole.SUPER_ADMIN.
model PlatformPaymentSettings {
  id                       String   @id @default(uuid())
  companySharePercent      Decimal  @default(70.0) @db.Decimal(5, 2)
  developerSharePercent    Decimal  @default(30.0) @db.Decimal(5, 2)
  superAdminFeePercent     Decimal  @default(0.10) @db.Decimal(5, 2)
  payoutAccount            Json?
  // Gateway credentials + support email — SUPER_ADMIN-only (see
  // PaymentSettingsController's separate /gateway routes), unlike the
  // revenue-split fields above which regular ADMIN can also see/edit.
  // FlutterwaveService/OpayService read these first and fall back to their
  // env vars when null, so a fresh environment still works from .env alone.
  // Stored in plaintext, not encrypted at rest — access is already gated to
  // SUPER_ADMIN at the API layer; add field-level encryption later if the
  // threat model needs to cover direct DB access too.
  flutterwavePublicKey     String?
  flutterwaveSecretKey     String?
  flutterwaveEncryptionKey String?
  opayMerchantId           String?
  opayPublicKey            String?
  opaySecretKey            String?
  supportEmail             String?
  // Dojah identity-verification credentials — DojahService reads these
  // first and falls back to DOJAH_APP_ID/DOJAH_SECRET_KEY/DOJAH_ENVIRONMENT
  // env vars when null, same override pattern as the payment keys above.
  // Lets a SUPER_ADMIN activate real-time NIN/BVN + liveness checks by
  // pasting a key into the app instead of touching server env vars.
  dojahAppId               String?
  dojahSecretKey           String?
  // "sandbox" (default) or "production" — selects Dojah's base URL.
  dojahEnvironment         String?
  // Whether "Pay on delivery" (PaymentProvider.COD) is offered as a
  // checkout option at all — off by default so a fresh environment
  // doesn't silently let buyers skip online payment. Surfaced publicly
  // via GET /settings (SettingsService merges it in) since checkout runs
  // before a buyer necessarily has admin-level access to read it
  // directly from here; writes stay SUPER_ADMIN-only through this table.
  codEnabled               Boolean  @default(false)
  // Gmail SMTP credentials for outgoing email (order confirmations, etc.)
  // — EmailService reads these first and falls back to the server's SMTP_*
  // env vars when null, same override pattern as the keys above. gmailUser
  // is the sending Gmail address; gmailAppPassword is a 16-character Gmail
  // App Password (not the account's login password — Gmail requires an App
  // Password for SMTP auth, generated at myaccount.google.com/apppasswords,
  // which needs 2-Step Verification enabled on the account first).
  gmailUser                String?
  gmailAppPassword         String?
  updatedAt                DateTime @updatedAt

  @@map("platform_payment_settings")
}

// One row per vendor (vendorId set), one row per buyer with a referral
// bonus balance (buyerId set), plus exactly one platform/super-admin row
// (both null, application-enforced singleton — see WalletsService's
// getOrCreatePlatformWallet, which filters on both fields to avoid
// matching a buyer wallet).
model Wallet {
  id        String   @id @default(uuid())
  vendorId  String?  @unique
  buyerId   String?  @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("NGN")
  updatedAt DateTime @updatedAt

  vendor       VendorProfile?      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  buyer        User?               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  @@map("wallets")
}

model WalletTransaction {
  id                  String                @id @default(uuid())
  walletId            String
  type                WalletTransactionType
  amount              Decimal               @db.Decimal(12, 2)
  balanceAfter        Decimal               @db.Decimal(12, 2)
  description         String
  vendorOrderId       String?
  withdrawalRequestId String?
  createdAt           DateTime              @default(now())

  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  vendorOrder       VendorOrder?       @relation(fields: [vendorOrderId], references: [id])
  withdrawalRequest WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])

  @@index([walletId])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id                String           @id @default(uuid())
  walletId          String
  // null for the platform wallet's self-initiated withdrawals (no separate
  // vendor to attribute it to — the requesting super admin is reviewedBy).
  vendorId          String?
  amount            Decimal          @db.Decimal(12, 2)
  status            WithdrawalStatus @default(PENDING)
  providerReference String?
  failureReason     String?
  requestedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  paidAt            DateTime?

  wallet       Wallet              @relation(fields: [walletId], references: [id])
  vendor       VendorProfile?      @relation(fields: [vendorId], references: [id])
  transactions WalletTransaction[]

  @@index([walletId])
  @@index([vendorId])
  @@map("withdrawal_requests")
}
