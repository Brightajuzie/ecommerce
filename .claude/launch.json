{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "expo", "start", "--web", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "mobile-web-prod-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "expo", "start", "--web", "--port", "8091", "--no-dev", "--minify"],
      "env": { "EXPO_PUBLIC_API_URL": "https://ikaystores-api.onrender.com/api/v1" },
      "port": 8091
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api", "run", "start:dev"],
      "port": 3001
    }
  ]
}
